@if (notice is not null)
{
    <p role="status">@notice</p>
}
else
{
    <figure class="query-chart">
        <figcaption>@description</figcaption>
        <svg viewBox="0 0 640 208" role="img" aria-label="@description">
            <path class="axes" d="M80 16 V168 H624" />
            <g class="labels">
                <text x="74" y="20" text-anchor="end">@yHigh</text>
                <text x="74" y="168" text-anchor="end">@yLow</text>
                <text x="80" y="192">@xLow</text>
                <text x="624" y="192" text-anchor="end">@xHigh</text>
            </g>
            @foreach (var s in series)
            {
                <g aria-label="@s.Label" fill="@s.Color">
                    <title>@s.Label</title>
                    <path class="series" d="@s.Path" stroke="@s.Color" stroke-dasharray="@s.Dash" />
                    @foreach (var point in s.Points)
                    {
                        <circle cx="@point.X" cy="@point.Y" r="3" />
                    }
                </g>
            }
        </svg>
        @if (showLegend)
        {
            <ul class="legend" aria-label="Chart series">
                @foreach (var s in series)
                {
                    <li>
                        <svg viewBox="0 0 32 12" aria-hidden="true">
                            <path class="series" d="M1 6 H31" stroke="@s.Color" stroke-dasharray="@s.Dash" />
                        </svg>
                        @s.Label
                    </li>
                }
            </ul>
        }
    </figure>
}
